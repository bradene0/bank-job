# Response headers for the Worker's static assets (Cloudflare reads this file; it is not served).
# The style-src hashes are the three <style> blocks @dnd-kit/dom 0.5 injects while dragging (drag
# feedback, grab cursor, no text selection). nginx.conf serves the same policy to the compose
# stack, and e2e fails on any CSP violation, so a dnd-kit upgrade that changes them is caught.
# Cloudflare Web Analytics (enabled on the zone) injects its beacon script from
# static.cloudflareinsights.com and reports to cloudflareinsights.com.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'sha256-E7zJXfkufcgTIQG1Th6iYnoGis+rTfZd044bgiM1kr4=' 'sha256-P3zrZWkaCzrI/B9T0+WLFRTTY8rvTIfnbvP5TBI9Vgo=' 'sha256-YYLJe/bgx7gKdFc8dp3EM3/S8hpKeZs7JyhfBoZYPuk='; img-src 'self' data:; font-src 'self'; connect-src 'self' https://bankjob-live.bradenevans.dev https://cloudflareinsights.com; frame-ancestors 'self' https://bradenevans.dev https://www.bradenevans.dev; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/replay/*
  Cache-Control: public, max-age=300
