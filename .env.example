# Copy to .env for local development. Never commit .env.

# LLM
LLM_MODE=stub                     # stub | live
ANTHROPIC_API_KEY=                # only needed for LLM_MODE=live
ANTHROPIC_MODEL=claude-haiku-5-5  # verify the current model ID in Anthropic's docs
LLM_MONTHLY_BUDGET_CENTS=1200     # game switches to replay mode near this

# Database
POSTGRES_DB=bankjob
POSTGRES_USER=bankjob
POSTGRES_PASSWORD=change-me-local-only

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Auth
JWT_SIGNING_KEY_PATH=./dev-keys/jwt-es256.pem   # generated locally in M1; prod key lives in SSM
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Game
DAILY_SEED_OVERRIDE=              # optional, for reproducible local testing
IDLE_STOP_MINUTES=30
