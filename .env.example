# Copy to .env for local development. Never commit .env.
# Compose reads everything after '=' as the value, so comments go on their own lines:
# "KEY=   # note" would set KEY to "# note".

# LLM
# stub | live. Stub never calls the model; live needs ANTHROPIC_API_KEY.
LLM_MODE=stub
ANTHROPIC_API_KEY=
# Verify the current model ID in Anthropic's docs.
ANTHROPIC_MODEL=claude-haiku-5-5
# The game switches to replay mode at 80% of this.
LLM_MONTHLY_BUDGET_CENTS=1200

# Database
POSTGRES_DB=bankjob
POSTGRES_USER=bankjob
POSTGRES_PASSWORD=change-me-local-only

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Auth
# Empty: compose uses an ephemeral key. Outside Docker, run
# services/game-api/scripts/generate-dev-jwt-key.sh. Production: SSM.
JWT_SIGNING_KEY_PATH=
# Empty: ephemeral locally. The production value lives in SSM.
IP_HASH_SALT=
# Guest sessions per client IP per hour (every Playwright test is a new player; raise it to run them).
SESSIONS_MAX_PER_IP_PER_HOUR=30
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Observability
# Jaeger v2 is the OTLP collector (ADR-0007). OTLP over HTTP; both services append /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Game
# Optional fixed seed for reproducible local runs (1-32 letters, digits or '-').
DAILY_SEED_OVERRIDE=
IDLE_STOP_MINUTES=30
